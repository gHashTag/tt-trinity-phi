{
  "contract": "specs/numeric/gf16_dot4_sky26d.t27",
  "issue": "https://github.com/gHashTag/tt-trinity-phi/issues/100",
  "note": "Hand-derived DOT4 conformance vectors, A[0..3] and B[0..3] as GF16 codes (S1 E6 M9, bias 31). Left fold: acc = p0, then three ADDs. test/oracle_selfcheck.py requires every expected value to equal the exact oracle; test/test.py (RTL and gate level) requires the pins to return it.",
  "vectors": [
    {"name": "selftest_30", "A": ["0x3E00","0x4000","0x4100","0x4200"], "B": ["0x3E00","0x4000","0x4100","0x4200"], "expected": "0x47C0", "why": "1+4+9+16 = 30.0, every step exact"},
    {"name": "b_all_ones_10", "A": ["0x3E00","0x4000","0x4100","0x4200"], "B": ["0x3E00","0x3E00","0x3E00","0x3E00"], "expected": "0x4480", "why": "1+2+3+4 = 10.0"},
    {"name": "alternating_signs_minus4", "A": ["0x3E00","0xC000","0x4100","0xC200"], "B": ["0x4000","0x4000","0x4000","0x4000"], "expected": "0xC200", "why": "2-4+6-8 = -4.0"},
    {"name": "b_zero_gives_zero", "A": ["0x3E00","0x4000","0x4100","0x4200"], "B": ["0x0000","0x0000","0x0000","0x0000"], "expected": "0x0000", "why": "B really participates"},
    {"name": "last_lane_only", "A": ["0x0000","0x0000","0x0000","0x3E00"], "B": ["0x0000","0x0000","0x0000","0x4000"], "expected": "0x4000", "why": "lane 3 is wired: 1.0 * 2.0"},
    {"name": "mul_tie_toward_zero", "A": ["0x3E10","0x0000","0x0000","0x0000"], "B": ["0x3E30","0x0000","0x0000","0x0000"], "expected": "0x3E41", "why": "(528*560)/512 = 577.5 exactly half: tie toward zero keeps 577 (M=65); ties-to-even would give 0x3E42"},
    {"name": "mul_tie_toward_zero_upper_binade", "A": ["0x3FFC","0x0000","0x0000","0x0000"], "B": ["0x3E80","0x0000","0x0000","0x0000"], "expected": "0x407D", "why": "(1020*640)/1024 = 637.5 exactly half in the [2,4) binade: tie toward zero keeps 637 (M=125 at E=32); a tie rounded up would give 0x407E"},
    {"name": "mul_rounding_carry_into_next_binade", "A": ["0x3ED4","0x0000","0x0000","0x0000"], "B": ["0x3ED4","0x0000","0x0000","0x0000"], "expected": "0x4000", "why": "(724*724)/512 = 1023.78 in the [1,2) binade rounds up to 1024: mantissa 0 and exponent + 1, 2.0 exactly"},
    {"name": "add_tie_keeps_even", "A": ["0x3E00","0x2A00","0x0000","0x0000"], "B": ["0x3E00","0x3E00","0x0000","0x0000"], "expected": "0x3E00", "why": "1 + 2^-10 is exactly half an ulp: RNE keeps the even 1.0"},
    {"name": "add_tie_rounds_to_even_up", "A": ["0x3E01","0x2A00","0x0000","0x0000"], "B": ["0x3E00","0x3E00","0x0000","0x0000"], "expected": "0x3E02", "why": "(1+2^-9) + 2^-10 is a tie with an odd mantissa: RNE rounds up to 0x3E02"},
    {"name": "subtract_alignment_sticky", "A": ["0x3E02","0xAA01","0x0000","0x0000"], "B": ["0x3E00","0x3E00","0x0000","0x0000"], "expected": "0x3E01", "why": "exact difference is 513.499 ulp units: just below the tie, so 0x3E01; truncating the shifted operand without a sticky bit would give the tie and 0x3E02"},
    {"name": "exact_cancellation_positive_zero", "A": ["0x3E00","0xBE00","0x0000","0x0000"], "B": ["0x3E00","0x3E00","0x0000","0x0000"], "expected": "0x0000", "why": "1 - 1 = +0, never -0"},
    {"name": "negative_zero_inputs", "A": ["0x8000","0x8000","0x8000","0x8000"], "B": ["0x8000","0x8000","0x8000","0x8000"], "expected": "0x0000", "why": "-0 inputs are zero, every arithmetic zero result is +0"},
    {"name": "negative_zero_plus_value", "A": ["0x8000","0x3E00","0x0000","0x0000"], "B": ["0x3E00","0x3E00","0x0000","0x0000"], "expected": "0x3E00", "why": "zero + x returns x unchanged"},
    {"name": "inf_times_zero_is_nan", "A": ["0x7E00","0x3E00","0x3E00","0x3E00"], "B": ["0x0000","0x3E00","0x3E00","0x3E00"], "expected": "0xFE01", "why": "Inf * 0 = NaN, and NaN propagates"},
    {"name": "plus_inf", "A": ["0x7E00","0x0000","0x0000","0x0000"], "B": ["0x3E00","0x3E00","0x3E00","0x3E00"], "expected": "0x7E00", "why": "Inf * 1 = +Inf, Inf + 0 = Inf"},
    {"name": "minus_inf", "A": ["0xFE00","0x0000","0x0000","0x0000"], "B": ["0x3E00","0x3E00","0x3E00","0x3E00"], "expected": "0xFE00", "why": "sign of Inf is the xor of the signs"},
    {"name": "opposite_inf_add_is_nan", "A": ["0x7E00","0xFE00","0x0000","0x0000"], "B": ["0x3E00","0x3E00","0x3E00","0x3E00"], "expected": "0xFE01", "why": "+Inf + -Inf = NaN"},
    {"name": "nan_payload_canonical", "A": ["0x7E01","0x3E00","0x3E00","0x3E00"], "B": ["0x3E00","0x3E00","0x3E00","0x3E00"], "expected": "0xFE01", "why": "any NaN operand gives 0xFE01"},
    {"name": "mul_overflow_inf", "A": ["0x7C00","0x0000","0x0000","0x0000"], "B": ["0x4000","0x0000","0x0000","0x0000"], "expected": "0x7E00", "why": "2^31 * 2 = 2^32: biased exponent 63 is Inf"},
    {"name": "mul_overflow_negative_inf", "A": ["0xFC00","0x0000","0x0000","0x0000"], "B": ["0x4000","0x0000","0x0000","0x0000"], "expected": "0xFE00", "why": "negative overflow is -Inf"},
    {"name": "mul_overflow_by_carry", "A": ["0x7DFF","0x0000","0x0000","0x0000"], "B": ["0x3E01","0x0000","0x0000","0x0000"], "expected": "0x7E00", "why": "(2-2^-9) * (1+2^-9) >= 2: exponent reaches 63"},
    {"name": "mul_underflow_flush", "A": ["0x0400","0x0000","0x0000","0x0000"], "B": ["0x0400","0x0000","0x0000","0x0000"], "expected": "0x0000", "why": "2^-58 flushes to +0"},
    {"name": "gap_2_pow_minus_31_flush", "A": ["0x0200","0x0000","0x0000","0x0000"], "B": ["0x3C00","0x0000","0x0000","0x0000"], "expected": "0x0000", "why": "2^-30 * 0.5 = 2^-31 has no code: flush to +0"},
    {"name": "smallest_code", "A": ["0x0201","0x0000","0x0000","0x0000"], "B": ["0x3C00","0x0000","0x0000","0x0000"], "expected": "0x0001", "why": "E=0 with M>0 is a normal number: (1+2^-9)*2^-31"},
    {"name": "largest_finite_times_one", "A": ["0x7DFF","0x0000","0x0000","0x0000"], "B": ["0x3E00","0x0000","0x0000","0x0000"], "expected": "0x7DFF", "why": "exact"},
    {"name": "mul_rounding_stays_in_binade", "A": ["0x3FFF","0x0000","0x0000","0x0000"], "B": ["0x3FFF","0x0000","0x0000","0x0000"], "expected": "0x41FE", "why": "1023^2/1024 = 1022.0009: rounds down to M=510 at E=32"},
    {"name": "add_overflow_inf", "A": ["0x7DFF","0x7DFF","0x0000","0x0000"], "B": ["0x3E00","0x3E00","0x3E00","0x3E00"], "expected": "0x7E00", "why": "max finite + max finite overflows to +Inf"},
    {"name": "subtract_to_small_power", "A": ["0x3E01","0xBE00","0x0000","0x0000"], "B": ["0x3E00","0x3E00","0x3E00","0x3E00"], "expected": "0x2C00", "why": "(1+2^-9) - 1 = 2^-9 exactly: E=22"},
    {"name": "tiny_addend_far_below_half_ulp", "A": ["0x3E00","0x0001","0x0000","0x0000"], "B": ["0x3E00","0x3E00","0x3E00","0x3E00"], "expected": "0x3E00", "why": "1 + about 2^-31 rounds to 1.0"}
  ]
}
